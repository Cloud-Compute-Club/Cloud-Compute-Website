---
import Layout from '../layouts/Layout.astro';
import { getAllPosts, getEvents } from '../api/api.js';
import PostCard from '../components/posts/PostCard.astro';

// SSR: Fetch data for the dashboard
// Since we don't have a direct 'getEvents' in api.js that is SSR-friendly easily, 
// I'll assume it exists or use a collection fetch. 
// Actually, let's just fetch all posts for now.
const posts = await getAllPosts(100);

// We'll need a way to check if user is admin. 
// For now, we'll let the client-side script handle the redirect if not admin, 
// to avoid complex cookie-based auth in this turn.
---

<Layout title="Admin Dashboard | Cloud Community Club">
    <main class="max-w-7xl mx-auto pt-32 pb-24 px-6 md:px-12 min-h-screen">
        <div id="admin-gate" class="hidden">
            <header class="mb-16 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h1 class="text-4xl md:text-6xl font-black tracking-tighter mb-4">Admin <span class="text-gradient">Control Center</span></h1>
                    <p class="text-text-secondary text-lg max-w-2xl">Manage content, events, and community engagement.</p>
                </div>
                <div class="flex gap-4">
                    <a
                        href="/create"
                        class="btn-primary flex items-center gap-2"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                        </svg>
                        New Architecture
                    </a>
                </div>
            </header>

            {/* Quick Stats */}
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-12">
                <div class="glass-card p-8 border-primary/20 bg-primary/5">
                    <p class="text-sm font-bold text-primary uppercase tracking-widest mb-1">Total Posts</p>
                    <h3 class="text-4xl font-black">{posts.length}</h3>
                </div>
                <div class="glass-card p-8 border-primary/20 bg-primary/5">
                    <p class="text-sm font-bold text-primary uppercase tracking-widest mb-1">Active Members</p>
                    <h3 class="text-4xl font-black">--</h3>
                </div>
            </div>

            {/* Dashboard Content */}
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
                <div class="lg:col-span-2 space-y-8">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-2xl font-bold">Manage Content</h2>
                        <div class="h-px bg-white/10 flex-grow mx-6"></div>
                    </div>
                    
                    <div class="space-y-4">
                        {posts.map(post => (
                            <div class="glass-card p-6 flex items-center justify-between gap-4 group hover:border-primary/30 transition-all">
                                <div class="flex-1 min-w-0">
                                    <h4 class="font-bold text-white mb-1 truncate">{post.title}</h4>
                                    <p class="text-xs text-text-secondary">
                                        By {post.authorName} • {post.votes || 0} votes • {post.createdAt?.seconds ? new Date(post.createdAt.seconds * 1000).toLocaleDateString() : 'Recent'}
                                    </p>
                                </div>
                                <div class="flex gap-2">
                                    <a href={`/post/edit/${post.id}`} class="p-2 rounded-lg bg-white/5 hover:bg-white/10 text-white/50 transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </a>
                                    <button class="p-2 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-500 transition-colors delete-post-btn" data-id={post.id}>
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                <aside class="space-y-8">
                    <h2 class="text-2xl font-bold">Admin Actions</h2>
                    <div class="glass-card p-6 space-y-4">
                        <button class="w-full btn-outline text-sm py-3 justify-start px-5" id="sync-resources">
                            Sync Resource Data
                        </button>
                        <button class="w-full btn-outline text-sm py-3 justify-start px-5 text-red-400 border-red-500/20 hover:bg-red-500/10">
                            Clear Audit Logs
                        </button>
                    </div>
                    
                    <div class="glass-card p-6 bg-primary/5 border-primary/20">
                        <h4 class="font-bold mb-2">Need Help?</h4>
                        <p class="text-xs text-text-secondary leading-relaxed">
                            Architecture posts require at least one diagram for featured status.
                        </p>
                    </div>
                </aside>
            </div>
        </div>

        <div id="access-denied" class="hidden min-h-[60vh] flex items-center justify-center">
            <div class="glass-card p-12 text-center max-w-md">
                <div class="w-20 h-20 bg-red-500/10 rounded-full flex items-center justify-center mx-auto mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <h2 class="text-2xl font-bold text-red-500 mb-4">Access Denied</h2>
                <p class="text-text-secondary mb-8">Administrators only beyond this point. Please sign in with an authorized account.</p>
                <a href="/login" class="btn-primary block">Sign In</a>
            </div>
        </div>

        <div id="loading-state" class="min-h-[60vh] flex items-center justify-center">
            <div class="flex flex-col items-center gap-4">
                <div class="h-12 w-12 border-4 border-primary/20 border-t-primary rounded-full animate-spin"></div>
                <p class="text-text-secondary font-bold tracking-widest uppercase text-xs">Verifying Credentials...</p>
            </div>
        </div>
    </main>
</Layout>

<script>
    import { $currentUser, $authLoading } from '../stores/authStore.js';
    import { deletePost } from '../api/api.js';

    const gate = document.getElementById('admin-gate');
    const denied = document.getElementById('access-denied');
    const loading = document.getElementById('loading-state');

    const checkAccess = (user, isLoading) => {
        if (isLoading) return;

        if (user && user.role === 'admin') {
            gate?.classList.remove('hidden');
            denied?.classList.add('hidden');
            loading?.classList.add('hidden');
        } else {
            gate?.classList.add('hidden');
            denied?.classList.remove('hidden');
            loading?.classList.add('hidden');
        }
    };

    $currentUser.subscribe(user => checkAccess(user, $authLoading.get()));
    $authLoading.subscribe(isLoading => checkAccess($currentUser.get(), isLoading));

    // Handle delete buttons
    document.querySelectorAll('.delete-post-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
            const id = (e.currentTarget as HTMLElement).dataset.id;
            if (!id) return;
            if (!confirm('Are you sure you want to delete this architecture?')) return;
            
            try {
                await deletePost(id);
                window.location.reload();
            } catch (err) {
                alert('Failed to delete: ' + err.message);
            }
        });
    });
</script>
