---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Join the Community | Cloud Community Club">
    <div class="min-h-screen flex items-center justify-center pt-24 px-6 bg-background-dark relative overflow-hidden">
        {/* Background Glow */}
        <div class="hidden md:block absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary/10 rounded-full blur-[120px] pointer-events-none"></div>

        <div class="max-w-md w-full glass-card p-10 z-10">
            <div class="text-center mb-10">
                <h2 class="text-3xl font-bold tracking-tight mb-2">
                    Create Account
                </h2>
                <p class="text-text-secondary">
                    Join the future of cloud computing.
                </p>
            </div>

            <div id="auth-container" class="w-full">
                <div id="error-message" class="hidden mb-6 p-4 bg-red-500/10 border border-red-500/20 rounded-xl text-red-500 text-sm"></div>
                <div id="success-message" class="hidden mb-6 p-4 bg-green-500/10 border border-green-500/20 rounded-xl text-green-500 text-sm"></div>

                <div class="space-y-6">
                    <button
                        id="google-signin"
                        class="w-full btn-outline py-3 flex items-center justify-center gap-3 group"
                    >
                        <svg class="w-5 h-5 group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
                            <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                            <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                            <path fill="currentColor" d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l3.66-2.84z" />
                            <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.66l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
                        </svg>
                        <span class="font-semibold text-white/90">Sign up with Google</span>
                    </button>

                    <div class="relative">
                        <div class="absolute inset-0 flex items-center">
                            <div class="w-full border-t border-white/10"></div>
                        </div>
                        <div class="relative flex justify-center text-xs uppercase">
                            <span class="bg-[#1a1a1a] px-4 text-text-secondary font-bold tracking-widest">Or continue with</span>
                        </div>
                    </div>

                    <form id="auth-form" class="space-y-6">
                        <div class="space-y-2">
                            <label class="text-sm font-medium text-white/70 ml-1">Username</label>
                            <input
                                type="text"
                                id="username"
                                required
                                class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 outline-none focus:border-primary/50 transition-colors text-white"
                                placeholder="cloud_architect"
                            />
                        </div>

                        <div class="space-y-2">
                            <label class="text-sm font-medium text-white/70 ml-1">Email Address</label>
                            <input
                                type="email"
                                id="email"
                                required
                                class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 outline-none focus:border-primary/50 transition-colors text-white"
                                placeholder="you@example.com"
                            />
                        </div>

                        <div class="space-y-2">
                            <label class="text-sm font-medium text-white/70 ml-1">Password</label>
                            <input
                                type="password"
                                id="password"
                                required
                                class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 outline-none focus:border-primary/50 transition-colors text-white"
                                placeholder="••••••••"
                            />
                        </div>

                        <button
                            type="submit"
                            id="submit-btn"
                            class="w-full btn-primary py-3.5 flex items-center justify-center gap-2"
                        >
                            <span id="btn-text">Create Account</span>
                            <div id="btn-loader" class="hidden h-5 w-5 border-2 border-background-dark/30 border-t-background-dark rounded-full animate-spin"></div>
                        </button>
                    </form>
                </div>

                <div class="mt-8 pt-8 border-t border-white/5 text-center">
                    <p class="text-text-secondary text-sm">
                        Already have an account?{' '}
                        <a href="/login" class="text-primary font-semibold hover:underline">
                            Log in instead
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script>
    import { signup, loginWithGoogle } from '../api/api.js';
    import { $currentUser } from '../stores/authStore.js';

    const form = document.getElementById('auth-form');
    const googleBtn = document.getElementById('google-signin');
    const errorEl = document.getElementById('error-message');
    const successEl = document.getElementById('success-message');
    const submitBtn = document.getElementById('submit-btn');
    const btnText = document.getElementById('btn-text');
    const btnLoader = document.getElementById('btn-loader');

    const showError = (msg) => {
        errorEl.textContent = msg;
        errorEl.classList.remove('hidden');
        successEl.classList.add('hidden');
    };

    const showSuccess = (msg) => {
        successEl.textContent = msg;
        successEl.classList.remove('hidden');
        errorEl.classList.add('hidden');
    };

    const hideMessages = () => {
        errorEl.classList.add('hidden');
        successEl.classList.add('hidden');
    };

    const setLoading = (loading) => {
        if (loading) {
            submitBtn.disabled = true;
            googleBtn.disabled = true;
            btnText.classList.add('hidden');
            btnLoader.classList.remove('hidden');
        } else {
            submitBtn.disabled = false;
            googleBtn.disabled = false;
            btnText.classList.remove('hidden');
            btnLoader.classList.add('hidden');
        }
    };

    // Redirect if already logged in
    $currentUser.subscribe(user => {
        if (user) {
            window.location.href = '/posts';
        }
    });

    googleBtn?.addEventListener('click', async () => {
        hideMessages();
        setLoading(true);
        try {
            const res = await loginWithGoogle();
            if (!res.success) throw new Error(res.error);
        } catch (err) {
            showError(err.message || 'Google sign-in failed');
            setLoading(false);
        }
    });

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideMessages();
        setLoading(true);

        const username = (document.getElementById('username') as HTMLInputElement).value;
        const email = (document.getElementById('email') as HTMLInputElement).value;
        const password = (document.getElementById('password') as HTMLInputElement).value;

        try {
            const res = await signup(email, password, username);
            if (!res.success) throw new Error(res.error);
            showSuccess(res.message || 'Account created successfully!');
            // Redirect after a short delay
            setTimeout(() => {
                window.location.href = '/posts';
            }, 2000);
        } catch (err) {
            showError(err.message || 'Account creation failed');
            setLoading(false);
        }
    });
</script>
